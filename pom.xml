	<dependencyManagement>
		<dependencies>
			<!-- Internal modules: single source of truth for the shared reactor version. -->
			<dependency>
				<groupId>ome.zarr</groupId>
				<artifactId>ome-zarr-imglib2</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>ome.zarr</groupId>
				<artifactId>ome-zarr-n5</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>ome.zarr</groupId>
				<artifactId>ome-zarr-zarrjava</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>ome.zarr</groupId>
				<artifactId>ome-zarr-fiji</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Not managed by pom-scijava. -->
			<dependency>
				<groupId>dev.zarr</groupId>
				<artifactId>zarr-java</artifactId>
				<version>${zarr-java.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-core</artifactId>
				<version>5.23.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Test dependencies shared by every module (all modules test with JUnit 5 -->
	<!-- and use the shared logback-test.xml from test-shared/resources). -->
	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- ====================================== -->

	<build>
		<!-- ZarrTestUtils and the sample OME-Zarr datasets live once, under -->
		<!-- test-shared/, and are wired into every module's test build below. -->
		<!-- ZarrTestUtils.resourcePath() resolves resources to a real filesystem -->
		<!-- Path, so the data must be copied into each module's target/test-classes -->
		<!-- (a test-jar would expose them only as jar: URLs, which Paths.get rejects). -->
		<testResources>
			<testResource>
				<directory>${project.basedir}/../test-shared/resources</directory>
			</testResource>
			<testResource>
				<directory>${project.basedir}/src/test/resources</directory>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-shared-test-source</id>
						<phase>generate-test-sources</phase>
						<goals>
							<goal>add-test-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.basedir}/../test-shared/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!-- Run tests in a single forked JVM so -Xmx4g takes effect (macOS CI -->
				<!-- runners OOM otherwise). -da avoids a bigdataviewer-core assertion bug: -->
				<!-- https://github.com/bigdataviewer/bigdataviewer-core/pull/217 -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<forkCount>1</forkCount>
						<reuseForks>true</reuseForks>
						<argLine>-Xmx4g -da -Dimagej.legacy.disable=true</argLine>
					</configuration>
				</plugin>
				<!-- Force javadoc onto the classpath instead of the JPMS module path. -->
				<!-- All modules share the ome.zarr base package, so in modular mode the -->
				<!-- plugin collapses them into a single "ome.zarr" module and drops the -->
				<!-- reactor-sibling jar (e.g. ome-zarr-imglib2), making its packages -->
				<!-- invisible to dependent modules ("package ome.zarr.imglib2 does not -->
				<!-- exist"). legacyMode keeps the pre-JPMS classpath behaviour. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<configuration>
						<legacyMode>true</legacyMode>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<profile>
			<id>coverage</id>
			<!-- Only pull the aggregate-coverage module into the reactor when measuring -->
			<!-- coverage, so normal builds and releases do not build it. It depends on -->
			<!-- all five modules, so it is built last and can read their jacoco.exec. -->
			<modules>
				<module>ome-zarr-coverage-report</module>
			</modules>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<forkCount>1</forkCount>
							<reuseForks>true</reuseForks>
							<argLine>@{argLine} -Xmx4g -da</argLine>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>0.8.7</version>
						<executions>
							<execution>
								<id>prepare-agent</id>
								<goals>
									<goal>prepare-agent</goal>
								</goals>
							</execution>
							<execution>
								<id>report</id>
								<goals>
									<goal>report</goal>
								</goals>
								<configuration>
									<formats>
										<format>XML</format>
									</formats>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
