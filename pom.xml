	<modules>
		<module>ome-zarr-imglib2</module>
		<module>ome-zarr-n5</module>
		<module>ome-zarr-zarrjava</module>
		<module>ome-zarr-fiji</module>
		<module>ome-zarr-fiji-ui</module>
	</modules>

	<!-- ====================================== -->

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<package-name>ome.zarr</package-name>

		<license.licenseName>bsd_2</license.licenseName>
		<license.projectName>OME-Zarr extras for Fiji</license.projectName>
		<license.organizationName>SciJava</license.organizationName>
		<license.copyrightOwners>SciJava developers</license.copyrightOwners>
		<license.excludes>**/zarr.json</license.excludes>

		<!-- NB: Parent pom-scijava sets Java 11. We override it here to stay compatible with FIJI stable / Java 8. -->
		<scijava.jvm.version>8</scijava.jvm.version>
		<scijava.jvm.build.version>[1.8.0-101,)</scijava.jvm.build.version>
		<!-- Use older versions of dependencies to stay compatible with FIJI stable / Java 8. -->
		<bigdataviewer-core.version>10.6.8</bigdataviewer-core.version>
		<scifio.version>0.48.0</scifio.version>

		<zarr-java.version>0.1.3</zarr-java.version>

		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
		<sonar.dynamicAnalysis>reuseReports</sonar.dynamicAnalysis>
		<sonar.coverage.jacoco.xmlReportPaths>
			${maven.multiModuleProjectDirectory}/ome-zarr-coverage-report/target/site/jacoco-aggregate/jacoco.xml
		</sonar.coverage.jacoco.xmlReportPaths>
		<sonar.language>java</sonar.language>
		<sonar.verbose>false</sonar.verbose>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
		<!-- NB: Temporary (2026-08-28). The `public` group 404s artifacts since the maven.scijava.org downtime, so the -->
		<!-- two hosted repos behind it are listed directly: `releases` (SciJava/ImgLib2/N5) and `thirdparty` -->
		<!-- (cisd:jhdf5, via n5-universe -> n5-hdf5). Additive - keep the group, it also aggregates proxies. Drop -->
		<!-- both once the group serves imglib2-cache-1.0.0-beta-20.pom and jhdf5-19.04.1.pom again. -->
		<repository>
			<id>scijava.releases</id>
			<url>https://maven.scijava.org/repository/releases</url>
		</repository>
		<repository>
			<id>scijava.thirdparty</id>
			<url>https://maven.scijava.org/repository/thirdparty</url>
		</repository>
		<!-- NB: The repos below replace proxies that scijava.public no longer has: its Nexus now exposes only the three -->
		<!-- hosted repos above (`/service/rest/v1/repositories` lists no proxy and no group), so every artifact that -->
		<!-- used to arrive through the group's proxies has to be fetched from its own upstream. Unidata serves -->
		<!-- edu.ucar:cdm-core (via dev.zarr:zarr-java), OME serves ome:formats-gpl / ome:turbojpeg and BeDataDriven -->
		<!-- serves org.renjin:* (both via sc.fiji:fiji, test scope). Keep these even after the group recovers - they -->
		<!-- are the canonical sources. -->
		<repository>
			<id>unidata-all</id>
			<name>Unidata All</name>
			<url>https://artifacts.unidata.ucar.edu/repository/unidata-all/</url>
		</repository>
		<repository>
			<id>ome</id>
			<name>OME Artifactory</name>
			<url>https://artifacts.openmicroscopy.org/artifactory/maven</url>
		</repository>
		<repository>
			<id>bedatadriven</id>
			<name>BeDataDriven Public Repository</name>
			<url>https://nexus.bedatadriven.com/content/groups/public/</url>
		</repository>
	</repositories>

