	<!-- ====================================== -->

	<scm>
		<connection>scm:git:git://github.com/BioImageTools/ome-zarr-fiji-java</connection>
		<developerConnection>scm:git:git@github.com:BioImageTools/ome-zarr-fiji-java</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/BioImageTools/ome-zarr-fiji-java</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/BioImageTools/ome-zarr-fiji-java/issues</url>
	</issueManagement>
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/BioImageTools/ome-zarr-fiji-java/actions</url>
	</ciManagement>

	<!-- ====================================== -->

	<modules>
		<module>ome-zarr-imglib2</module>
		<module>ome-zarr-n5</module>
		<module>ome-zarr-zarrjava</module>
		<module>ome-zarr-fiji</module>
		<module>ome-zarr-fiji-ui</module>
	</modules>

	<!-- ====================================== -->

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<package-name>ome.zarr</package-name>

		<license.licenseName>bsd_2</license.licenseName>
		<license.projectName>OME-Zarr extras for Fiji</license.projectName>
		<license.organizationName>SciJava</license.organizationName>
		<license.copyrightOwners>SciJava developers</license.copyrightOwners>
		<license.excludes>**/zarr.json</license.excludes>
		<license.trimHeaderLine>true</license.trimHeaderLine>

		<!-- NB: Parent pom-scijava sets Java 11. We override it here to stay compatible with FIJI stable / Java 8. -->
		<scijava.jvm.version>8</scijava.jvm.version>
		<scijava.jvm.build.version>[1.8.0-101,)</scijava.jvm.build.version>
		<!-- Use older versions of dependencies to stay compatible with FIJI stable / Java 8. -->
		<bigdataviewer-core.version>10.6.8</bigdataviewer-core.version>
		<scifio.version>0.48.0</scifio.version>

		<!-- 2.0.2 fixes (issue #153). The following line can be removed, when pom-scijava references a version >= 2.0.2 -->
		<n5-zarr.version>2.0.2</n5-zarr.version>
		<zarr-java.version>0.6.0</zarr-java.version>
		<jacoco.version>0.8.13</jacoco.version>
		<zarr.test.addOpens />
		<zarr.test.addOpensX11 />

		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
		<sonar.dynamicAnalysis>reuseReports</sonar.dynamicAnalysis>
		<sonar.coverage.jacoco.xmlReportPaths>
			${maven.multiModuleProjectDirectory}/ome-zarr-coverage-report/target/site/jacoco-aggregate/jacoco.xml
		</sonar.coverage.jacoco.xmlReportPaths>
		<sonar.language>java</sonar.language>
		<sonar.verbose>false</sonar.verbose>

		<releaseProfiles>sign,deploy-to-scijava</releaseProfiles>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<!-- ====================================== -->

	<dependencyManagement>
		<dependencies>
			<!-- Internal modules: single source of truth for the shared reactor version. -->
			<dependency>
				<groupId>ome.zarr</groupId>
				<artifactId>ome-zarr-imglib2</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>ome.zarr</groupId>
				<artifactId>ome-zarr-n5</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>ome.zarr</groupId>
				<artifactId>ome-zarr-zarrjava</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>ome.zarr</groupId>
				<artifactId>ome-zarr-fiji</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Not managed by pom-scijava. -->
			<dependency>
				<groupId>dev.zarr</groupId>
				<artifactId>zarr-java</artifactId>
				<version>${zarr-java.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-core</artifactId>
				<version>5.23.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Test dependencies shared by every module (all modules test with JUnit 5 -->
	<!-- and use the shared logback-test.xml from test-shared/resources). -->
	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- ====================================== -->

	<build>
		<!-- ZarrTestUtils and the sample OME-Zarr datasets live once, under -->
		<!-- test-shared/, and are wired into every module's test build below. -->
		<!-- ZarrTestUtils.resourcePath() resolves resources to a real filesystem -->
		<!-- Path, so the data must be copied into each module's target/test-classes -->
		<!-- (a test-jar would expose them only as jar: URLs, which Paths.get rejects). -->
		<testResources>
			<testResource>
				<directory>${project.basedir}/../test-shared/resources</directory>
			</testResource>
			<testResource>
				<directory>${project.basedir}/src/test/resources</directory>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-shared-test-source</id>
						<phase>generate-test-sources</phase>
						<goals>
							<goal>add-test-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.basedir}/../test-shared/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Compares each module against its latest release and fails on binary incompatibility. -->
			<plugin>
				<groupId>com.github.siom79.japicmp</groupId>
				<artifactId>japicmp-maven-plugin</artifactId>
				<version>0.23.1</version>
				<executions>
					<execution>
						<goals>
							<goal>cmp</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<parameter>
						<oldVersionPattern>\d+\.\d+\.\d+</oldVersionPattern>
						<breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
						<ignoreMissingClasses>true</ignoreMissingClasses>
						<ignoreMissingOldVersion>true</ignoreMissingOldVersion>
						<!-- Deliberate 0.11 removals of API deprecated in 0.10.x. Drop these once 0.11 is released. -->
						<excludes>
							<exclude>ome.zarr.imglib2.ZarrUtils</exclude>
							<exclude>ome.zarr.imglib2.util.ZarrUtils#ZarrUtils()</exclude>
							<exclude>ome.zarr.imglib2.PyramidContents#omero</exclude>
							<exclude>ome.zarr.imglib2.metadata.Omero$Channel#window</exclude>
							<exclude>ome.zarr.imglib2.metadata.Omero$Channel$Window#start</exclude>
							<exclude>ome.zarr.imglib2.metadata.Omero$Channel$Window#end</exclude>
							<exclude>ome.zarr.imglib2.metadata.Omero$Channel$Window#min</exclude>
							<exclude>ome.zarr.imglib2.metadata.Omero$Channel$Window#max</exclude>
							<exclude>ome.zarr.fiji.read.OmeZarr#OmeZarr(java.net.URI,org.scijava.Context,ome.zarr.imglib2.PyramidBackend,java.lang.Integer)</exclude>
							<exclude>ome.zarr.fiji.util.BdvUtils#registerViewer(ome.zarr.fiji.bdv.PyramidalBdv,bdv.viewer.AbstractViewerPanel,ome.zarr.fiji.plugins.PyramidalService)</exclude>
							<exclude>ome.zarr.fiji.util.BdvUtils#registerBdvWindow(ome.zarr.fiji.PyramidalBdv,java.awt.Window,ome.zarr.fiji.plugins.PyramidalService)</exclude>
							<exclude>ome.zarr.fiji.util.BdvUtils#registerBdvWindow(ome.zarr.fiji.bdv.PyramidalBdv,java.awt.Window,ome.zarr.fiji.plugins.PyramidalService)</exclude>
							<exclude>ome.zarr.fiji.util.BdvUtils#setChannelProperties(java.util.List,java.util.List,bdv.viewer.ConverterSetups,bdv.viewer.ViewerState)</exclude>
							<exclude>ome.zarr.fiji.util.BdvUtils#omeroChannels(ome.zarr.imglib2.metadata.Omero,int)</exclude>
							<exclude>ome.zarr.fiji.util.BdvUtils#setTimepoint(ome.zarr.imglib2.metadata.Omero,bdv.viewer.ViewerState)</exclude>
						</excludes>
					</parameter>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!-- Run tests in a single forked JVM so -Xmx4g takes effect (macOS CI -->
				<!-- runners OOM otherwise). -da avoids a bigdataviewer-core assertion bug: -->
				<!-- https://github.com/bigdataviewer/bigdataviewer-core/pull/217 -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<forkCount>1</forkCount>
						<reuseForks>true</reuseForks>
						<argLine>-Xmx4g -da -Dimagej.legacy.disable=true ${zarr.test.addOpens}
							${zarr.test.addOpensX11}
						</argLine>
					</configuration>
				</plugin>
				<!-- Targeting release 8 is deliberate (Fiji-Stable). Make the linter more quiet -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<compilerArgs>
							<arg>-Xlint:-options</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<!-- Force javadoc onto the classpath instead of the JPMS module path. -->
				<!-- All modules share the ome.zarr base package, so in modular mode the -->
				<!-- plugin collapses them into a single "ome.zarr" module and drops the -->
				<!-- reactor-sibling jar (e.g. ome-zarr-imglib2), making its packages -->
				<!-- invisible to dependent modules ("package ome.zarr.imglib2 does not -->
				<!-- exist"). legacyMode keeps the pre-JPMS classpath behaviour. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<configuration>
						<legacyMode>true</legacyMode>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<profile>
			<id>open-java-lang</id>
			<activation>
				<jdk>[9,)</jdk>
			</activation>
			<properties>
				<zarr.test.addOpens>--add-opens=java.base/java.lang=ALL-UNNAMED</zarr.test.addOpens>
			</properties>
		</profile>
		<profile>
			<id>open-sun-awt-x11</id>
			<activation>
				<jdk>[16,)</jdk>
				<os>
					<name>linux</name>
				</os>
			</activation>
			<properties>
				<zarr.test.addOpensX11>--add-opens=java.desktop/sun.awt.X11=ALL-UNNAMED</zarr.test.addOpensX11>
			</properties>
		</profile>
		<profile>
			<id>coverage</id>
			<!-- Only pull the aggregate-coverage module into the reactor when measuring -->
			<!-- coverage, so normal builds and releases do not build it. It depends on -->
			<!-- all five modules, so it is built last and can read their jacoco.exec. -->
			<modules>
				<module>ome-zarr-coverage-report</module>
			</modules>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<forkCount>1</forkCount>
							<reuseForks>true</reuseForks>
							<argLine>@{argLine} -Xmx4g -da ${zarr.test.addOpens} ${zarr.test.addOpensX11}</argLine>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>${jacoco.version}</version>
						<executions>
							<execution>
								<id>prepare-agent</id>
								<goals>
									<goal>prepare-agent</goal>
								</goals>
							</execution>
							<execution>
								<id>report</id>
								<goals>
									<goal>report</goal>
								</goals>
								<configuration>
									<formats>
										<format>XML</format>
									</formats>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
