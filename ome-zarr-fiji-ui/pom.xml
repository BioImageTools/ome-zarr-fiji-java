	<dependencies>
		<!-- Pulls in all four sibling artifacts. -->
		<dependency>
			<groupId>ome.zarr</groupId>
			<artifactId>ome-zarr-imglib2</artifactId>
		</dependency>
		<dependency>
			<groupId>ome.zarr</groupId>
			<artifactId>ome-zarr-n5</artifactId>
		</dependency>
		<dependency>
			<groupId>ome.zarr</groupId>
			<artifactId>ome-zarr-zarrjava</artifactId>
		</dependency>
		<dependency>
			<groupId>ome.zarr</groupId>
			<artifactId>ome-zarr-fiji</artifactId>
		</dependency>

		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common</artifactId>
		</dependency>
		<!-- Opens the Fiji script editor on DnD when no script is preset. -->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>script-editor</artifactId>
		</dependency>
		<!-- LinkHandler / Links API used by LinkHandlerPlugin.
		     NB: scijava-desktop is Java 11 bytecode, so it cannot be loaded on a
		     Java 8 Fiji-Stable. It is therefore 'provided': Fiji-Latest ships it in
		     jars/, and it must not be dragged along as a transitive runtime
		     dependency onto Fiji-Stable. This module itself stays Java 8 (see the
		     enforcer configuration below).
		     When scijava-desktop is absent (Fiji-Stable), SciJava plugin discovery
		     skips LinkHandlerPlugin with a logged warning. -->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-desktop</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- N5ViewerCreator (n5.bdv) + N5Importer (n5.ij) used by ZarrOpenActions. -->
		<dependency>
			<groupId>org.janelia.saalfeldlab</groupId>
			<artifactId>n5-viewer_fiji</artifactId>
		</dependency>
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<!-- ====================================== -->
		<!-- test dependencies -->
		<!-- ====================================== -->
		<dependency>
			<groupId>sc.fiji</groupId>
			<artifactId>fiji</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			NB: Re-declares pom-scijava-base's enforceBytecodeVersion rule with
			scijava-desktop added to the excludes. scijava-desktop is Java 11
			bytecode while this module currently targets Java 8, and 'provided' - unlike
			'test' - is not among the rule's ignoredScopes, so the build would
			otherwise fail with "Found Banned Dependency: org.scijava:scijava-desktop".
			Maven merges this same-named rule into the inherited enforce-rules
			execution rather than replacing the whole <rules> list, so the other
			pom-scijava rules still run.
			Keep the remaining excludes and options in sync with pom-scijava-base when bumping the parent.
			Delete this plugin declaration when the module is bumped to Java 11.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-rules</id>
						<configuration>
							<rules>
								<enforceBytecodeVersion>
									<maxJdkVersion>${scijava.jvm.version}</maxJdkVersion>
									<excludes>
										<exclude>com.headius:invokebinder</exclude>
										<exclude>com.sun:tools</exclude>
										<exclude>org.scijava:scijava-desktop</exclude>
									</excludes>
									<ignoreClasses>
										<ignoreClass>module-info</ignoreClass>
									</ignoreClasses>
									<ignoredScopes>
										<ignoredScope>test</ignoredScope>
									</ignoredScopes>
								</enforceBytecodeVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
